# ============================================================
# 청기백기 게임 서버 설정
# 이 파일의 값을 수정하면 nginx와 serve에 자동 반영됩니다.
# ============================================================

# npx serve 가 실행될 내부 포트 (localhost 전용)
SERVE_PORT=3000

# nginx 가 외부에 노출할 포트
NGINX_PORT=80

# 도메인 또는 IP (없으면 _ 로 설정하면 모든 호스트 허용)
SERVER_NAME=_

# nginx 접근 로그 경로 (비활성화: /dev/null)
ACCESS_LOG=/var/log/nginx/flag_game_access.log

# nginx 에러 로그 경로
ERROR_LOG=/var/log/nginx/flag_game_error.log

# 정적 파일 gzip 압축 (on / off)
GZIP=on

# 클라이언트 최대 업로드 크기
CLIENT_MAX_BODY_SIZE=1m
